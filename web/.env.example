VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_BASE_URL=http://localhost:8080
VITE_GITSLICE_GIT_HTTP_BASE_URL=http://localhost:8081

# Product analytics (PostHog) — optional. These are BUILD-TIME Vite vars, so set
# them in the env file sourced by web/scripts/deploy.sh (../.env.staging,
# ../.env.prod), NOT in wrangler.jsonc. Leave unset to keep analytics a no-op.
# VITE_POSTHOG_KEY is the PUBLIC project key (safe to embed in the client).
# VITE_POSTHOG_HOST should point at the first-party /ingest reverse proxy in
# staging/prod (e.g. https://agenttools.dev/ingest, https://gitslice.io/ingest);
# leave unset for local dev to hit the PostHog default host.
# VITE_POSTHOG_KEY=phc_replace_me
# VITE_POSTHOG_HOST=https://gitslice.io/ingest
# EU project only — the /ingest proxy defaults to the US region otherwise:
# VITE_POSTHOG_UPSTREAM_HOST=eu.i.posthog.com
# VITE_POSTHOG_UPSTREAM_ASSETS_HOST=eu-assets.i.posthog.com

# Dev/testing only — do NOT set for production builds. When enabled, the app
# authenticates with a bearer token from localStorage["gitslice.dev.token"] (or a
# one-time ?__dev_token= param) instead of Clerk, for headless/automated testing.
# The token must still be one the server accepts (e.g. `gs auth mint-service-token`).
# VITE_ENABLE_DEV_AUTH=1
