{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitslice-web",
  "compatibility_date": "2026-06-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PUBLIC_API_BASE_URL": "https://api.gitslice.io"
  },
  "env": {
    "staging": {
      "name": "gitslice-web-staging",
      "routes": [
        {
          "pattern": "agenttools.dev",
          "custom_domain": true
        }
      ],
      "vars": {
        "PUBLIC_API_BASE_URL": "https://api.agenttools.dev",
        "PUBLIC_GITSLICE_GIT_HTTP_BASE_URL": "https://api.agenttools.dev"
      }
    }
  }
}
