PUBLIC_API_BASE_URL=https://api.gitslice.io
PUBLIC_GITSLICE_GIT_HTTP_BASE_URL=https://api.gitslice.io
CLERK_ISSUER=https://clerk.gitslice.io
CLERK_AUTHORIZED_PARTIES=https://gitslice.io
VITE_CLERK_AUTHORIZED_PARTIES=https://gitslice.io

VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZ2l0c2xpY2UuaW8k
CLERK_SECRET_KEY=gitslice-secret:CLERK_SECRET_KEY

R2_ACCESS_KEY_ID=gitslice-secret:R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=gitslice-secret:R2_SECRET_ACCESS_KEY
