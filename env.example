# Copy this file to env.local and edit values for your machine.
#
# Make targets such as `make cli`, `make rpc`, `make functional`, and
# `make load` include env.local automatically. For direct shell commands, load
# it first with:
#
#   set -a
#   . ./env.local
#   set +a
#   go test -count=1 ./tests/cli ./tests/rpc -v

GITSLICE_TEST_DATABASE_URL=postgres://YOUR_USER@localhost/gitslice_dev?sslmode=disable

# Optional: override the database used by `make run-server`.
# GITSLICE_DATABASE_URL=postgres://YOUR_USER@localhost/gitslice_dev?sslmode=disable

# --- Object storage ---
# Default is a local filesystem store rooted at GITSLICE_OBJECT_STORE_ROOT.
# Set OBJECT_STORE_TYPE=r2 to use Cloudflare R2 (S3-compatible) instead.
# GITSLICE_OBJECT_STORE_ROOT=/tmp/gitslice-objects
# OBJECT_STORE_TYPE=r2
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=gitslice-dev
# R2_PREFIX=dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_USE_PATH_STYLE=false

# --- Auth provider ---
# Default uses the built-in dev/fake account login. Set AUTH_PROVIDER=clerk to
# verify Clerk session tokens and JIT-provision subjects on first request.
# AUTH_PROVIDER=clerk
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_JWKS_URL=   # optional; derived from the publishable key when empty

# For a full staging configuration see .env.staging (gitignored).
